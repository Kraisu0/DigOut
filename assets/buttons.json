    small-red: { down: button.wood.down, up: button.wood.up, disabled: button.wood.disable, pressedOffsetX: 1, pressedOffsetY: -1, font: small-font, fontColor: red },
    small-dark-red: { down: button.wood.down, up: button.wood.up, disabled: button.wood.disable, pressedOffsetX: 1, pressedOffsetY: -1, font: small-font, fontColor: dark-red },
    list-small: { down: button.wood.down, up: button.wood.up, disabled: button.wood.down, pressedOffsetX: 1, pressedOffsetY: -1, font: small-font }
